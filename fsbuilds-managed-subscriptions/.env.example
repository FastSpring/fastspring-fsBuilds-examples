# =============================================================================
# STOREFRONT env - port 4000. This is the customer-facing storefront/
# checkout page only.
#
# This project ALSO has a separate "enterprise-backend" service in the
# enterprise-backend/ folder, with its OWN .env, on port 4100 - do NOT
# put Subscriptions API credentials (FASTSPRING_API_USERNAME/PASSWORD)
# in THIS file. Those authenticate server-to-server calls to
# api.fastspring.com and belong only in enterprise-backend/.env, never
# here. This file only ever needs the checkout snippet values below.
# =============================================================================
PORT=4000

# From FastSpring: Checkouts > Embedded Checkouts > [your checkout] >
# Place on your Website. Copy both fresh from the account - don't reuse
# an old value even if a path name looks familiar. These get templated
# into a static <script id="fsc-api"> tag by server/index.js.
STOREFRONT_URL=fsbuilds.test.onfastspring.com/embedded-SyncWrx
SBL_SCRIPT_URL=https://sbl.onfastspring.com/sbl/1.0.7/fastspring-builder.min.js

# From FastSpring app > Developer Tools > Webhooks > your webhook > Secret Key.
# Not yet wired into server/index.js - see the TODO there.
FASTSPRING_WEBHOOK_SECRET=
