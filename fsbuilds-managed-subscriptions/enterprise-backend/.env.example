# =============================================================================
# SUBSCRIPTION MANAGEMENT BACKEND env - port 4100. This is the SEPARATE service
# that talks to FastSpring's Subscriptions API and receives webhooks. This is
# NOT the storefront's .env (port 4000, checkout snippet only) - if you're
# looking at this file, you're in the right place for API credentials. The
# checkout snippet (STOREFRONT_URL/SBL_SCRIPT_URL) belongs in ../.env instead.
# =============================================================================
PORT=4100

# FastSpring app > Developer Tools > APIs > API Credentials.
# Server-to-server only - never exposed to a browser. FastSpring shows the
# password once at creation; there is one active credential pair per Store,
# and resetting invalidates the old pair everywhere it's in use.
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=

# FastSpring app > Developer Tools > Webhooks > [your webhook] > Secret Key.
# Used to verify the X-FS-Signature header (HMAC-SHA256 of the raw body,
# base64). Without it the server still runs but accepts webhooks unverified.
# Your FastSpring store's site ID - visible in the URL when you open a
# subscription in the FastSpring app:
# https://app.fastspring.com/subscription/home.xml?mRef=Subscription:XXX&cRef=BasicStoreSite:{SITE_ID}
# Used to build direct deep links to subscriptions in the FastSpring dashboard.
# This is stable per store - won't change between transactions.
# With Webhook Expansion enabled, this is also captured automatically from
# order.siteId in the payload and doesn't need to be set manually.
FASTSPRING_SITE_ID=

# How often the billing loop checks for due subscriptions and dunning retries.
BILLING_CHECK_INTERVAL_MS=60000

# --- DEMO ONLY -------------------------------------------------------------
# Real billing cycles are months long, which makes them impossible to show in
# a live demo. Setting these compresses cycles so a full bill -> fail -> retry
# -> recover loop happens in minutes. Leave BLANK for real calendar cycles.
DEMO_CYCLE_MINUTES=
DEMO_RETRY_MINUTES=
